{
  "name": "example-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute google-login-board-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute google-login-board-db --remote --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute google-login-board-db --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "typescript": "^5.5.4",
    "wrangler": "^4.0.0"
  }
}
